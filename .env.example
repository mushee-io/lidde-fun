# Read-only proof of a separate Lidde EVM sandbox.
# These must be real, observed values from a deployed chain. Leave blank until verified.
LIDDE_FUN_TESTNET_CHAIN_ID=
LIDDE_FUN_RPC_URL=
LIDDE_FUN_EXPLORER_URL=
LIDDE_FUN_GENESIS_HASH=
LIDDE_FUN_FACTORY_ADDRESS=
LIDDE_FUN_FACTORY_CODE_HASH=
LIDDE_FUN_ROUTER_ADDRESS=
LIDDE_FUN_ROUTER_CODE_HASH=

# Optional: the canonical Lidde DEX testnet market indexer endpoint.
# Do not set this to a generic third-party feed or use mainnet as a sandbox.
LIDDE_DEX_MARKETS_API_URL=

# Optional isolated-sandbox token creator. Both fields must be present and match
# a deployed, reviewed LiddeDemoTokenFactory; otherwise the creator is disabled.
LIDDE_FUN_TOKEN_CREATOR_ADDRESS=
LIDDE_FUN_TOKEN_CREATOR_CODE_HASH=

# Phase 3 requires a separate Neon DB with db/migrations/013_quests.sql applied.
# Never commit connection strings or keys. Unset means all off-chain quest writes fail closed.
QUEST_DATABASE_URL=
QUEST_PUBLIC_ORIGIN=

# Contract address and KECCAK256 of deployed QuestEscrow runtime bytecode.
LIDDE_FUN_QUEST_VAULT_ADDRESS=
LIDDE_FUN_QUEST_VAULT_CODE_HASH=

# Testnet-only authorized EIP-712 attestor key (server-side secret; never NEXT_PUBLIC).
LIDDE_FUN_QUEST_ATTESTOR_PRIVATE_KEY=

# M19: signed writes and wallet transactions are OFF by default.
# Enable only after external valueless-testnet evidence and review.
LIDDE_FUN_WRITES_ENABLED=false
# Operator emergency stop overrides enabling the flag above.
LIDDE_FUN_EMERGENCY_STOP=false
