# Read-only proof of a separate Lidde EVM sandbox.
# These must be real, observed values from a deployed chain. Leave blank until verified.
LIDDE_FUN_TESTNET_CHAIN_ID=
LIDDE_FUN_RPC_URL=
LIDDE_FUN_EXPLORER_URL=
LIDDE_FUN_GENESIS_HASH=
LIDDE_FUN_FACTORY_ADDRESS=
LIDDE_FUN_FACTORY_CODE_HASH=
LIDDE_FUN_ROUTER_ADDRESS=
LIDDE_FUN_ROUTER_CODE_HASH=

# Optional: the canonical Lidde DEX testnet market indexer endpoint.
# Do not set this to a generic third-party feed or use mainnet as a sandbox.
LIDDE_DEX_MARKETS_API_URL=

# Optional isolated-sandbox token creator. Both fields must be present and match
# a deployed, reviewed LiddeDemoTokenFactory; otherwise the creator is disabled.
LIDDE_FUN_TOKEN_CREATOR_ADDRESS=
LIDDE_FUN_TOKEN_CREATOR_CODE_HASH=
